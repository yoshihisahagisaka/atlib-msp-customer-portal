FROM node:24-bookworm-slim AS build
WORKDIR /app
ENV PUPPETEER_SKIP_DOWNLOAD=true
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json tsconfig.secure-guard-migration.json tsconfig.secure-guard-migration-build.json ./
COPY src ./src
# Preserve the approved Staging 001-005 artifact exactly. MFA 006 is CI-only.
COPY migrations/secure_guard_runner.ts ./migrations/secure_guard_runner.ts
COPY migrations/secure_guard/00[1-5]*.sql ./migrations/secure_guard/
COPY migration-manifests/secure-guard-staging-001-005.json ./migration-manifests/secure-guard-staging-001-005.json
COPY scripts/readiness/verifySecureGuardMigrationManifest.cjs ./scripts/readiness/verifySecureGuardMigrationManifest.cjs
RUN npm run build:secure-guard-migration
RUN node scripts/readiness/verifySecureGuardMigrationManifest.cjs migration-manifests/secure-guard-staging-001-005.json migrations/secure_guard true

FROM node:24-bookworm-slim AS production-deps
WORKDIR /runtime
COPY migration-runtime/package.json migration-runtime/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

# Review-only alternative: reuse the application runtime proven by PR19.
FROM node:24-alpine@sha256:116b800c3754b440ee0aa3ed2f20f5bf3d99a554bfd9adeea09ea8017f6e85f5
RUN apk add --no-cache --upgrade \
    'openssl=3.5.9-r1' \
    'libcrypto3=3.5.9-r1' \
    'libssl3=3.5.9-r1' \
    'zlib=1.4-r0' \
  && rm -rf /usr/local/lib/node_modules/npm \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx
WORKDIR /app
ARG SOURCE_REVISION
LABEL org.opencontainers.image.revision=$SOURCE_REVISION
ENV NODE_ENV=production
COPY --chown=node:node migration-runtime/package.json ./package.json
COPY --from=production-deps --chown=node:node /runtime/node_modules ./node_modules
COPY --from=build --chown=node:node /app/dist-secure-guard-migration ./dist-secure-guard-migration
COPY --from=build --chown=node:node /app/migrations/secure_guard ./migrations/secure_guard
COPY --from=build --chown=node:node /app/migration-manifests/secure-guard-staging-001-005.json ./migration-manifests/secure-guard-staging-001-005.json
COPY --from=build --chown=node:node /app/scripts/readiness/verifySecureGuardMigrationManifest.cjs ./scripts/readiness/verifySecureGuardMigrationManifest.cjs
USER node
ENTRYPOINT ["node"]
CMD ["dist-secure-guard-migration/migrations/secure_guard_runner.js"]
