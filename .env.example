# このファイルはテンプレートです。実際の値は絶対にコミットしないこと。
# 本番(Cloud Run)ではこれらは Secret Manager / --set-env-vars 経由で注入する。

NODE_ENV=development
PORT=8080

# GCP
GCP_PROJECT_ID=msp-zabbix

# JWT (本番は Secret Manager: portal-jwt-secret)
JWT_SECRET=change-me-in-local-dev-only
JWT_EXPIRES_IN=24h

# DB (本番は Cloud SQL Unix socket 経由。ローカル開発時はCloud SQL Auth Proxyを別途起動するか、
#     ローカルPostgresを使う場合は DB_HOST/DB_PORT を使う)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=msp_customer_portal
DB_USER=portal_app
DB_PASSWORD=change-me-in-local-dev-only
# Cloud Run本番用（設定されていればこちらを優先しUnixソケット接続する）
DB_SOCKET_PATH=

# Zabbix (本番は Secret Manager: portal-zabbix-user / portal-zabbix-password)
ZABBIX_API_URL=https://10.146.0.3/api_jsonrpc.php
ZABBIX_API_HOST_HEADER=zabbix.atlib.jp
ZABBIX_API_USER=change-me
ZABBIX_API_PASSWORD=change-me
# Zabbix環境のメール用メディアタイプID（Zabbix管理画面 > 通知 > メディアタイプ で確認）
ZABBIX_MEDIATYPE_EMAIL=change-me
# オンボーディング時に通知用Zabbixユーザーを所属させるユーザーグループID
ZABBIX_NOTIFICATION_USRGRPID=change-me
# 通知専用ユーザーに割り当てるロールID（Zabbix 7.0のuser.createで必須。管理画面 > ユーザー > ロール で確認）
ZABBIX_NOTIFICATION_ROLEID=change-me
# Phase 3: 機器追加時に使うテンプレートID
ZABBIX_TEMPLATE_ICMP=change-me
ZABBIX_TEMPLATE_SNMP=change-me

# SMTP (Gmail/Workspace個人メールボックス経由。smtp-relay.gmail.comはWorkspace管理コンソール側の
#      SMTPリレーサービス設定が別途必要なため、特定の1アカウントから送るだけの用途では
#      smtp.gmail.com + アプリパスワードの方がシンプルで確実に動く)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=change-me@atlib.jp
SMTP_PASSWORD=change-me
SMTP_FROM=change-me@atlib.jp

# パスワードリセットURLのベース
PASSWORD_RESET_URL_BASE=https://portal.atlib.jp/reset-password

# 管理画面(/admin/*)のBasic Auth (本番は Secret Manager: portal-admin-user / portal-admin-password)
ADMIN_BASIC_AUTH_USER=change-me
ADMIN_BASIC_AUTH_PASSWORD=change-me

# ISMS診断フォーム: 新規回答の通知先（カンマ区切りで複数可）
DIAGNOSTIC_NOTIFY_EMAIL=sales@atlib.jp

# 月次レポート自動化(フェーズ4/5)
MONTHLY_REPORT_STORAGE_BUCKET=msp-customer-portal-reports
MONTHLY_REPORT_STAFF_EMAIL=change-me@atlib.jp
# 顧客への送付メール・バッチ完了通知メール専用の送信元(SMTP_FROMとは別。noreply@atlib.jp等を想定)
MONTHLY_REPORT_FROM_EMAIL=noreply@atlib.jp
